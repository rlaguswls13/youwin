<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.youwin.repository.NoticeRepository">

    <!-- ================================================================= -->
    <!-- 1. 공통 검색 조건 (SQL 조각)                                        -->
    <!-- ================================================================= -->
    <sql id="searchWhere">
        <where>
            <if test="category != null and category != '' and category != '전체' and category != 'all'">
                AND category = #{category}
            </if>

            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="searchType == 'title'">
                        AND title LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test="searchType == 'content'">
                        AND content LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test="searchType == 'writer'">
                        AND member_id LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <otherwise>
                        AND (title LIKE CONCAT('%', #{keyword}, '%')
                        OR content LIKE CONCAT('%', #{keyword}, '%'))
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>


    <!-- ================================================================= -->
    <!-- 2. 등록 (INSERT) 영역                                             -->
    <!-- ================================================================= -->

    <!-- 공지사항 게시글 등록 (useGeneratedKeys로 PK 자동 반환) -->
    <insert id="save" parameterType="com.youwin.dto.NoticeDto" useGeneratedKeys="true" keyProperty="noticeId">
        INSERT INTO notice_board (member_id, category, title, content)
        VALUES (#{memberId}, #{category}, #{title}, #{content})
    </insert>

    <!-- 다중 이미지 일괄 등록 (Batch Insert) -->
    <insert id="insertNoticeImages" parameterType="list">
        INSERT INTO notice_images (notice_id, original_name, saved_file_name)
        VALUES
        <foreach collection="images" item="img" separator=",">
            (#{img.noticeId}, #{img.originalName}, #{img.savedFileName})
        </foreach>
    </insert>

    <!-- 단일 이미지 등록 (필요 시 활용) -->
    <insert id="insertImage" parameterType="com.youwin.dto.NoticeImageDto" useGeneratedKeys="true" keyProperty="imageId">
        INSERT INTO notice_images (notice_id, original_name, saved_file_name)
        VALUES (#{noticeId}, #{originalName}, #{savedFileName})
    </insert>


    <!-- ================================================================= -->
    <!-- 3. 조회 (SELECT) 영역                                             -->
    <!-- ================================================================= -->

    <!-- 전체 목록 조회 (기본 전체) -->
    <select id="findAll" resultType="com.youwin.dto.NoticeDto">
        SELECT notice_id AS noticeId,
        member_id AS memberId,
        category,
        title,
        content,
        create_at AS createAt
        FROM notice_board
        ORDER BY notice_id DESC
    </select>

    <!-- 페이징 및 검색 조건이 적용된 목록 조회 (검색 객체 사용) -->
    <select id="findAllWithPaging" parameterType="com.youwin.dto.BoardSearchCondition" resultType="com.youwin.dto.NoticeDto">
        SELECT notice_id AS noticeId,
        member_id AS memberId,
        category,
        title,
        content,
        create_at AS createAt,
        DATE_FORMAT(create_at, '%Y-%m-%d %H:%i') AS createAtStr
        FROM notice_board
        <include refid="searchWhere" />
        ORDER BY notice_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 페이징 및 검색 조건이 적용된 목록 조회 (Map 파라미터 호환용) -->
    <select id="findAllWithPagingMap" parameterType="map" resultType="com.youwin.dto.NoticeDto">
        SELECT notice_id AS noticeId,
        member_id AS memberId,
        category,
        title,
        content,
        create_at AS createAt,
        DATE_FORMAT(create_at, '%Y-%m-%d %H:%i') AS createAtStr
        FROM notice_board
        <include refid="searchWhere" />
        ORDER BY notice_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 조건에 맞는 전체 게시글 총 개수 (페이징 계산용) -->
    <select id="countTotal" parameterType="com.youwin.dto.BoardSearchCondition" resultType="int">
        SELECT COUNT(*)
        FROM notice_board
        <include refid="searchWhere" />
    </select>

    <!-- 조건에 맞는 전체 게시글 총 개수 (Map 파라미터 호환용) -->
    <select id="countTotalMap" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM notice_board
        <include refid="searchWhere" />
    </select>

    <!-- 공지사항 단건 상세 조회 -->
    <select id="findById" parameterType="long" resultType="com.youwin.dto.NoticeDto">
        SELECT notice_id AS noticeId,
        member_id AS memberId,
        category,
        title,
        content,
        create_at AS createAt,
        DATE_FORMAT(create_at, '%Y-%m-%d %H:%i') AS createAtStr
        FROM notice_board
        WHERE notice_id = #{noticeId}
    </select>

    <!-- 특정 공지사항에 딸린 첨부 이미지 목록 조회 -->
    <select id="selectImagesByNoticeId" parameterType="long" resultType="com.youwin.dto.NoticeImageDto">
        SELECT image_id AS imageId,
        notice_id AS noticeId,
        original_name AS originalName,
        saved_file_name AS savedFileName,
        reg_date AS regDate
        FROM notice_images
        WHERE notice_id = #{noticeId}
        ORDER BY image_id ASC
    </select>


    <!-- ================================================================= -->
    <!-- 4. 수정 (UPDATE) 영역                                             -->
    <!-- ================================================================= -->

    <!-- 공지사항 기본 정보 수정 (값이 있는 항목만 동적 변경) -->
    <update id="update" parameterType="com.youwin.dto.NoticeDto">
        UPDATE notice_board
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="category != null">category = #{category},</if>
            <if test="content != null">content = #{content},</if>
            update_at = CURRENT_TIMESTAMP
        </set>
        WHERE notice_id = #{noticeId}
    </update>


    <!-- ================================================================= -->
    <!-- 5. 삭제 (DELETE) 영역                                             -->
    <!-- ================================================================= -->

    <!-- 공지사항 글 삭제 -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM notice_board WHERE notice_id = #{noticeId}
    </delete>

    <!-- 특정 공지사항에 연결된 모든 이미지 데이터 삭제 -->
    <delete id="deleteImagesByNoticeId" parameterType="long">
        DELETE FROM notice_images WHERE notice_id = #{noticeId}
    </delete>

    <!-- 수정 시 특정 개별 이미지 데이터만 개별 삭제 -->
    <delete id="deleteImageById" parameterType="long">
        DELETE FROM notice_images WHERE image_id = #{imageId}
    </delete>

</mapper>